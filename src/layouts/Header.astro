---
import NavBar from "../components/NavBar.astro";
---

<header class="fixed flex justify-between h-[8dvh] w-full px-4 py-2 z-10">
  <div class="h-full aspect-square rounded-sm bg-primary"></div>
  <h2
    class="font-headings text-heading-md flex items-center justify-center text-center grow"
  >
    
  </h2>
  <NavBar />
</header>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  gsap.registerPlugin(ScrollTrigger, SplitText);

  const title = document.querySelector("header h2");

  let tl = gsap.timeline();
  let split = SplitText.create("header h2",{type:"chars"});

  tl.fromTo(
    split.chars,
    {
      yPercent: "random([-100,100])",
      opacity:0
    },
    {
        
      text:"Experiencia laboral",
      yPercent: 0,
      opacity:1,
      stagger: {
        from: "random",
        each:0.05,
      },
      scrollTrigger: {
        trigger: "#Experience",
        start: "top center",
        end: "top top",
        scrub: 1,
      },
    },
  );
</script>
