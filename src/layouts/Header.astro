---
import NavBar from "../components/NavBar.astro";
---

<header class="fixed flex justify-between h-[8dvh] w-full px-4 py-2 z-10">
    <div class="h-full aspect-square rounded-sm bg-primary"></div>
    <div
        class="relative font-semibold font-headings text-heading-md text-primary text-center grow"
    >
        <h2 id="title_0" class="absolute inset-0">Experiencia</h2>
        <h2 id="title_1" class="absolute inset-0">Technologias</h2>
        <h2 id="title_2" class="absolute inset-0">Proyectos</h2>
    </div>
    <NavBar />
</header>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";
    gsap.registerPlugin(ScrollTrigger, SplitText);

    const sections = ["#Experience", "#Technologie", "#Projects"];

    const titles = document.querySelectorAll("header h2");

    let i = 0;

    titles.forEach((title) => {
        let split = SplitText.create(title, { type: "chars" });
        let tl = gsap.timeline({
            scrollTrigger: {
                trigger: sections[i],
                start: "top center",
                end: "center top",
                scrub: true,
            },
        });

        tl.from(split.chars, {
            opacity: 0,
            yPercent: "random([-100,100])",
            stagger: {
                from: "random",
                each: 0.05,
            },
        }).to(split.chars, {
            opacity: 0,
            yPercent: "random([-100,100])",
            stagger: {
                from: "random",
                each: 0.05,
            },
        });

        i++;
    });
</script>
