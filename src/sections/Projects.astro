<script>
    import gsap from "gsap";
    import ScrollToPlugin from "gsap/ScrollToPlugin";
    import ScrollTrigger from "gsap/ScrollTrigger";
    import ScrollSmoother from "gsap/ScrollSmoother";

    gsap.registerPlugin(ScrollToPlugin, ScrollTrigger, ScrollSmoother);

    const slides = document.querySelectorAll(".projects");

    const scrolling = gsap.to("#carousel-track", {
        xPercent: -200, // si duplicaste el contenido 1 vez (2x el original)
        ease: "none",
        duration: 20, // controla la velocidad
        repeat: -1,
    });

    slides.forEach((s) => {
        s.addEventListener("click", () => {
        });
    });
</script>
