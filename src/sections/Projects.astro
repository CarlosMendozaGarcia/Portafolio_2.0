---
import { Projects } from "../data/projects.data";
---

<section
    id="Projects"
    class="relative flex flex-col items-center justify-center w-full h-full gap-2 px-4 pt-[9dvh] pb-4 overflow-hidden"
>
    <div
        class="carousel absolute flex w-full h-50 overflow-hidden z-10 bg-primary"
    >
        <div class="flex w-full h-full">
            {
                Projects.map((p, i) => (
                    <div
                        data-project={i}
                        class="slides shrink-0  w-1/3 text-background"
                        style={{
                            width: `calc(${1 / (Projects.length - 1)}*100%)`,
                        }}
                    >
                        {" "}
                        {p.title}
                    </div>
                ))
            }
        </div>
    </div>
    <div id="container" class="relative flex flex-col grow w-full">
        {
            Projects.map((p, i) => (
                <div
                    id={"project_" + i.toString()}
                    class="projects absolute flex shrink-0 h-full w-full "
                >
                    <div class="flex flex-col justify-evenly w-1/2 p-2">
                        <div class="flex flex-col gap-2">
                            <h2 class="font-headings text-heading-md text-primary font-bold">
                                {p.title}
                            </h2>
                            <div class="flex gap-2 ">{p.tags.map((t) => (
                                <div class="rounded-full py-1 px-2 text-body-sm font-display bg-secondary text-background ">{t}</div>
                            ))}</div>
                        </div>
                        <p class="text-body-lg font-body text-pretty">
                            {p.description}
                        </p>
                        {(p.urlGithub || p.urlWebsite) && (
                            <div class="flex font-display items-center justify-between ">
                                {p.urlGithub && (
                                    <a  href={p.urlWebsite} class="button-primary w-1/4 h-10">
                                        Visitar sitio
                                    </a>
                                )}
                                {p.urlWebsite && (
                                    <a  href={p.urlGithub} class="button-secondary w-1/4 h-10">
                                        Github
                                    </a>
                                )}
                            </div>
                        )}
                    </div>
                    <div id="Image" class="w-1/2 h-full border-2" />

                    <button
                        type="button"
                        data-button={i}
                        class="hide right-0 absolute button-primary active:brightness-125"
                    >
                        quitar
                    </button>
                </div>
            ))
        }
    </div>
</section>

<script>
    import gsap from "gsap";
    import Flip from "gsap/Flip";
    import ScrollSmoother from "gsap/ScrollSmoother";
    import ScrollTrigger from "gsap/ScrollTrigger";
    import horizontalLoop from "../lib/horizontalLoop";

    gsap.registerPlugin(Flip, ScrollSmoother, ScrollTrigger);

    const slides: Array<HTMLAnchorElement> = gsap.utils.toArray(".slides");
    /* const carousel = document.querySelector(".carousel"); */
    const buttons: Array<HTMLButtonElement> = gsap.utils.toArray(".hide");
    const loop = horizontalLoop(slides, { paused: false });

    function Carousel(reveal: boolean) {
        let state = Flip.getState(".carousel");
        if (reveal) {
            gsap.set(".carousel", {
                position: "static",
            });
        } else {
            gsap.set(".carousel", {
                position: "absolute",
            });
        }
        Flip.from(state, {
            absolute: true,
            duration: 1,
            ease: "power1.inOut",
        });
    }

    function openProjects(i?: string) {
        let projectTl = gsap.timeline({
            duration: 1,
            ease: "power1.inOut",
        });

        gsap.set(`.projects`, {
            opacity: 0,
            yPercent: 100,
        });

        if (i) {
            projectTl.to(`#project_${i}`, {
                opacity: 1,
                yPercent: 0,
            });
        }
        return projectTl;
    }

    function closeProjects(i: string) {
        let projectTl = gsap.timeline({
            duration: 1,
            ease: "power1.inOut",
        });

        projectTl.to(
            `#project_${i}`,
            {
                opacity: 0,
                yPercent: 100,
            },
            ">",
        );

        return projectTl;
    }

    openProjects();
    slides.forEach((p) => {
        const id = p.dataset.project;
        p.addEventListener("click", () => {
            Carousel(true);
            loop.toIndex(id, { duration: 1, ease: "power1.inOut" });
            openProjects(id);
        });
    });

    buttons.forEach((b) => {
        b.addEventListener("click", () => {
            const id = b.dataset.button ?? "";
            closeProjects(id);
            Carousel(false);
            loop.play()
        });
    });
</script>
