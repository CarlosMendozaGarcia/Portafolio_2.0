---
import { Image } from "astro:assets";
import { Projects } from "../data/projects.data";
---

<section
    id="Projects"
    class="relative flex flex-col items-center justify-center w-full h-full gap-2 px-4 pt-[9dvh] pb-4 overflow-hidden"
>
    <div
        class="carousel absolute flex w-full h-30 lg:h-50 overflow-hidden z-10 bg-primary"
    >
        <div class="flex w-full h-full">
            {
                Projects.map((p, i) => {
                    const coverImage = p.images[0];
                    return (
                        <div
                            tabindex={i}
                            data-project={i}
                            class="group flex items-center justify-center slides shrink-0   text-background"
                            style={{
                                width: `calc(${1 / (Projects.length - 1)}*100%)`,
                            }}
                        >
                            <Image
                                src={coverImage}
                                alt="Casamigos"
                                class="object-cover w-full h-full"
                            />
                            <span class="absolute flex items-center justify-center text-heading-sm font-headings font-bold bg-primary w-full h-full group-hover:bg-primary/50 group-hover:backdrop-blur-xs group-focus-within:bg-primary/50 group-focus-within:backdrop-blur-xs transition-all duration-100">
                                {p.title}
                            </span>
                        </div>
                    );
                })
            }
        </div>
    </div>
    <div id="container" class="relative flex flex-col grow w-full">
        {
            Projects.map((p, i) => {
                const image = p.images[1] ?? p.images[0];
                return (
                    <div
                        id={"project_" + i.toString()}
                        class="projects absolute flex flex-col lg:flex-row shrink-0 h-full w-full "
                    >
                        <div class="flex flex-col justify-evenly grow w-full lg:w-1/2 p-2">
                            <div class="flex flex-col gap-2">
                                <h2 class="font-headings text-heading-md text-primary font-bold">
                                    {p.title}
                                </h2>
                                <div class="flex flex-wrap gap-2 ">
                                    {p.tags.map((t) => (
                                        <div class="rounded-full py-1 px-2 text-body-sm font-display bg-secondary text-background ">
                                            {t}
                                        </div>
                                    ))}
                                </div>
                            </div>
                            <p class="text-body-sm font-body text-pretty">
                                {p.description}
                            </p>
                            {(p.urlGithub || p.urlWebsite) && (
                                <div class="flex font-display items-center justify-between ">
                                    {p.urlGithub && (
                                        <a
                                            href={p.urlWebsite}
                                            class="button-primary w-fit h-10"
                                        >
                                            Visitar sitio
                                        </a>
                                    )}
                                    {p.urlWebsite && (
                                        <a
                                            href={p.urlGithub}
                                            class="button-secondary w-fit h-10"
                                        >
                                            Github
                                        </a>
                                    )}
                                </div>
                            )}
                        </div>
                        <div
                            id="Image"
                            class="flex relative w-full lg:w-1/2 h-1/2 rounded-xl overflow-hidden"
                        >
                            <Image
                                src={image}
                                alt="Casamigos"
                                class="object-cover blur-md "
                            />
                            <Image
                                src={image}
                                alt="Casamigos"
                                class="absolute object-scale-down w-full h-full bg-background/50"
                            />
                        </div>
                        <button
                            type="button"
                            data-button={i}
                            class="hide right-0 absolute button-primary active:brightness-125"
                        >
                            quitar
                        </button>
                    </div>
                );
            })
        }
    </div>
</section>

<script>
    import gsap from "gsap";
    import Flip from "gsap/Flip";
    import ScrollSmoother from "gsap/ScrollSmoother";
    import ScrollTrigger from "gsap/ScrollTrigger";
    import horizontalLoop from "../lib/horizontalLoop";

    gsap.registerPlugin(Flip, ScrollSmoother, ScrollTrigger);

    const slides: Array<HTMLAnchorElement> = gsap.utils.toArray(".slides");
    const buttons: Array<HTMLButtonElement> = gsap.utils.toArray(".hide");
    const loop = horizontalLoop(slides, { paused: false, repeat: -1 });

    let currentProjectTl: gsap.core.Timeline | null = null;
    let currentCarouselTween: gsap.core.Tween | gsap.core.Timeline | null =
        null;

    function Carousel(reveal: boolean) {
        if (currentCarouselTween) currentCarouselTween.kill();

        let state = Flip.getState(".carousel");
        if (reveal) {
            gsap.set(".carousel", {
                position: "static",
            });
        } else {
            gsap.set(".carousel", {
                position: "absolute",
            });
        }
        currentCarouselTween = Flip.from(state, {
            absolute: true,
            duration: 1,
            ease: "power1.inOut",
        });
    }

    function openProjects(i?: string) {
        if (currentProjectTl) currentProjectTl.kill();

        currentProjectTl = gsap.timeline({
            duration: 1,
            ease: "power1.inOut",
        });

        gsap.set(`.projects`, {
            opacity: 0,
            yPercent: 100,
        });

        if (i) {
            currentProjectTl.to(`#project_${i}`, {
                opacity: 1,
                yPercent: 0,
            });
        }
        return currentProjectTl;
    }

    function closeProjects(i: string) {
        if (currentProjectTl) currentProjectTl.kill();

        currentProjectTl = gsap.timeline({
            duration: 1,
            ease: "power1.inOut",
        });

        currentProjectTl.to(
            `#project_${i}`,
            {
                opacity: 0,
                yPercent: 100,
            },
            ">",
        );

        return currentProjectTl;
    }

    openProjects();
    loop.p;
    slides.forEach((p) => {
        const id = p.dataset.project;
        p.addEventListener("click", () => {
            Carousel(true);
            loop.toIndex(id, { duration: 1, ease: "power1.inOut" });
            openProjects(id);
        });
    });

    buttons.forEach((b) => {
        b.addEventListener("click", () => {
            const id = b.dataset.button ?? "";
            closeProjects(id);
            Carousel(false);
            loop.play();
        });
    });
</script>
