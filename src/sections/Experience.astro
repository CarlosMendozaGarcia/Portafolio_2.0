---
import WorkCard from "../components/WorkCard.astro";
import Left from "../assets/Left.svg";
import Right from "../assets/Right.svg";
import { Jobs } from "../data/work.data";
---

<section id="Experience" class="relative flex w-full h-full">
    <div
        class="background absolute grid grid-cols-30 grid-rows-20 w-full h-full gap-1 pt-[9dvh] px-4 pb-4 -z-10"
    >
        {
            Array.from({ length: 600 }, (v, i) => i).map((o) => (
                <div class={`will-change-grid mask-[url(../assets/Stars.svg)] mask-center mask-no-repeat`} />
            ))
        }
    </div>
    <div
        id="Slider"
        class="flex w-full h-full overflow-hidden pt-[9dvh] pb-4 "
    >
        {
            Jobs.map((j) => (
                <div
                    id={`work_${j.id}`}
                    class="shrink-0 flex justify-around items-center gap-3  w-full h-full snap-start  px-4"
                >
                    <a
                        class={`${j.id == 1 ? "opacity-0 pointer-events-none hidden md:block" : "opacity-100"} shrink-0 text-heading-md font-display size-10 text-secondary bg-background/50 backdrop-blur-xs border-2 rounded-full stroke-2 stroke-primary`}
                        href={`#work_${j.id - 1}`}
                    >
                        <Left/>
                    </a>
                    <WorkCard
                        company={j.company}
                        position={j.position}
                        initialDate={j.initialDate}
                        endDate={j.endDate}
                        skills={j.skills}
                    />
                    <a
                        class={`${j.id == Jobs.length ? "opacity-0 pointer-events-none hidden md:block" : "opacity-100"} shrink-0 text-heading-md font-display size-10 text-secondary bg-background/50 backdrop-blur-xs border-2  rounded-full stroke-2 stroke-primary`}
                        href={`#work_${j.id + 1}`}
                    >
                        <Right/>
                    </a>
                </div>
            ))
        }
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollToPlugin } from "gsap/ScrollToPlugin";

    gsap.registerPlugin(ScrollToPlugin);

    const slides = document.querySelectorAll("#Slider a");

    const cells = gsap.utils.toArray(".background > div") as HTMLElement[];

    function getRandomCells(pool: HTMLElement[], count: number): HTMLElement[] {
        const shuffled = [...pool].sort(() => Math.random() - 0.5);
        return shuffled.slice(0, count);
    }

    function animateRandomBatch(count: number) {
        const targets = getRandomCells(cells, count);

        gsap.fromTo(
            targets,
            { scale: 1, opacity: 0.2 },
            {
                scale: 1.5,
                background: "var(--secondary)",
                opacity: 0.8,
                duration: 0.6,
                ease: "power2.out",
                stagger: {
                    each: 0.03,
                    from: "random", // orden random dentro de este batch
                },
                yoyo: true,
                repeat: 1, // vuelve a su estado original
            },
        );
    }

    const batchSizes = [10, 15, 20, 25, 30];
    let cycle = 0;

    function runCycle() {
        const count = batchSizes[cycle % batchSizes.length];
        animateRandomBatch(count);
        cycle++;
    }

    function loopCycles() {
        runCycle();
        gsap.delayedCall(1.5, loopCycles);
    }
    
    function scrollSlide(href: string) {
        gsap.to("#Slider", {
            duration: 1,
            scrollTo: { x: href },
            ease: "power2.inOut",
        });
    }

    slides.forEach((element) => {
        const href = element.getAttribute("href") ?? "";

        if (!href.startsWith("#")) return;

        element.addEventListener("click", (e) => {
            e.preventDefault();
            scrollSlide(href);
        });
    });
    loopCycles();
</script>
