---
import { array } from "astro:schema";
import TechStack from "../components/TechStack.astro";

const techStack = [
    {
        name: "Next.JS",
        proficiency: 80,
    },
    {
        name: "Next.JS",
        proficiency: 20,
    },
    {
        name: "Next.JS",
        proficiency: 48,
    },
    {
        name: "Next.JS",
        proficiency: 59,
    },
    {
        name: "Next.JS",
        proficiency: 32,
    },
    {
        name: "Next.JS",
        proficiency: 45,
    },
    {
        name: "Next.JS",
        proficiency: 20,
    },
    {
        name: "Next.JS",
        proficiency: 15,
    },
];
let total = 0;

techStack.forEach((t) => {
    return (total += t.proficiency);
});
---

<section
    id="Technologie"
    class="flex flex-col justify-end w-full h-full border-2 px-6 pb-6 pt-[8dvh]"
>
    <div
        id="Container"
        class="grid grid-cols-10 grid-rows-10  gap-2 h-full w-full  p-2"
    >
        {
            techStack.map((t) => (
                <TechStack
                    name={t.name}
                    size={Math.floor((t.proficiency * 100) / total)}
                />
            ))
        }
        
    </div>
    <div class="shrink-0 flex justify-center gap-2">
        <button type="button" class="font-headings button-secondary"
            >FrontEnd</button
        >
        <button type="button" class="font-headings button-secondary"
            >Backend</button
        >
        <button type="button" class="font-headings button-secondary"
            >Base de datos</button
        >
        <button type="button" class="font-headings button-secondary"
            >Librerias y Plugins</button
        >
    </div>
</section>
<script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";
    import { InertiaPlugin } from "gsap/InertiaPlugin";
    gsap.registerPlugin(Draggable, InertiaPlugin);

    const techs = document.querySelectorAll("#TechStack");
    const canva = document.querySelector("#Container");

    techs.forEach((t) => {
        Draggable.create(t, {
            bounds: canva,
            inertia: true
        });
        ondrag
    });
</script>
